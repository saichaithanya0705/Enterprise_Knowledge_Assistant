# --- Key Gateway (chat / answer generation only) ---
# Provided separately. Never commit the real value.
KEY_GATEWAY_URL=
KEY_GATEWAY_API_KEY=
KEY_GATEWAY_CHAT_MODEL=gpt-4o-mini

# --- NVIDIA NIM API (embeddings + reranking only) ---
# Get a key from https://build.nvidia.com — never commit the real value.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RERANK_URL=https://integrate.api.nvidia.com/v1/ranking
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# --- App ---
APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/knowledge_assistant.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=8
TOP_K_FINAL_CONTEXT=4
SIMILARITY_THRESHOLD=0.15
